# API on Render + Neon; production uses the same startup safety gates.
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
PILOT_MODE=true
DATABASE_URL=postgresql://user:password@host:5432/launchcomply
# Set true for one-instance Docker startup migrations (including Render Free).
# For multiple instances, use one separate migration job and set this false.
MIGRATE_ON_STARTUP=true
# Generate independent random secrets in Render; these are placeholders.
JWT_SECRET=replace-with-a-random-secret
ENCRYPTION_KEY=replace-with-an-independent-random-secret
BACKEND_CORS_ORIGINS=["https://your-project.vercel.app"]
# Providers remain disabled until implementation and external verification pass.
ENABLE_REAL_EMAIL=false
EMAIL_PROVIDER=mock
ENABLE_REAL_STRIPE=false
ENABLE_REAL_RAZORPAY=false
ENABLE_AI_COPILOT=false

# GitHub App: configure all OAuth fields for account connection.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-project.vercel.app/onboarding/github/callback
# Generate a PEM private key in GitHub App settings for repository analysis.
GITHUB_APP_PRIVATE_KEY=
# Optional actual architecture assistant. Enable only after configuring the key.
OPENAI_API_KEY=
ARCHITECTURE_AI_MODEL=gpt-4.1-mini
# Optional read-only official AWS documentation references in architecture drafts.
ENABLE_AWS_KNOWLEDGE=false

# Operations-approved one-time service payments. Add real keys privately in Render.
ENABLE_SERVICE_PAYMENTS=false
BILLING_RETURN_ORIGIN=https://your-project.vercel.app
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ENABLE_REAL_STRIPE / ENABLE_REAL_RAZORPAY above stay false until configured.

# Cross-account observation only; requires the actual runtime to assume this role.
ENABLE_AWS_ACCOUNT_CONNECTION=false
AWS_PLATFORM_ROLE_ARN=
# Supply short-lived AWS runtime credentials through the SDK credential chain.
# This flag does not enable infrastructure deployment or monitoring.

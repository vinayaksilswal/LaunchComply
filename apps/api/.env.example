# API on Render + Neon; production uses the same startup safety gates.
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
PILOT_MODE=true
DATABASE_URL=postgresql://user:password@host:5432/launchcomply
# Set true for one-instance Docker startup migrations (including Render Free).
# For multiple instances, use one separate migration job and set this false.
MIGRATE_ON_STARTUP=true
# Generate independent random secrets in Render; these are placeholders.
JWT_SECRET=replace-with-a-random-secret
ENCRYPTION_KEY=replace-with-an-independent-random-secret
BACKEND_CORS_ORIGINS=["https://your-project.vercel.app"]
# Providers remain disabled until implementation and external verification pass.
ENABLE_REAL_EMAIL=false
EMAIL_PROVIDER=mock
ENABLE_REAL_STRIPE=false
ENABLE_REAL_RAZORPAY=false
ENABLE_AI_COPILOT=false

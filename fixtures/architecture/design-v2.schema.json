{
  "$defs": {
    "Association": {
      "additionalProperties": false,
      "properties": {
        "route_table_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::RouteTable",
          "title": "Route table",
          "type": "string"
        },
        "subnet_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::Subnet",
          "title": "Subnet",
          "type": "string"
        }
      },
      "required": [
        "subnet_node_id",
        "route_table_node_id"
      ],
      "title": "Association",
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": false,
      "properties": {
        "gateway_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::InternetGateway",
          "title": "Internet gateway",
          "type": "string"
        },
        "vpc_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::VPC",
          "title": "VPC",
          "type": "string"
        }
      },
      "required": [
        "vpc_node_id",
        "gateway_node_id"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "BucketConfiguration": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "$ref": "#/$defs/BucketProperties"
        },
        "resource_type": {
          "const": "AWS::S3::Bucket",
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "properties"
      ],
      "title": "BucketConfiguration",
      "type": "object"
    },
    "BucketProperties": {
      "additionalProperties": false,
      "properties": {
        "versioning": {
          "default": true,
          "title": "Object versioning",
          "type": "boolean"
        }
      },
      "title": "BucketProperties",
      "type": "object"
    },
    "ConfigReference": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "anyOf": [
            {
              "maximum": 79,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        },
        "property": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Property",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "property"
      ],
      "title": "ConfigReference",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "authentication": {
          "default": "UNKNOWN",
          "enum": [
            "NONE",
            "JWT",
            "IAM",
            "MTLS",
            "UNKNOWN"
          ],
          "title": "Authentication",
          "type": "string"
        },
        "caller_mode": {
          "default": "UNKNOWN",
          "enum": [
            "BROWSER",
            "SERVER",
            "WORKER",
            "UNKNOWN"
          ],
          "title": "Caller Mode",
          "type": "string"
        },
        "derived_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "destination_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Port"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "default": "UNKNOWN",
          "enum": [
            "DECLARED",
            "INFERRED",
            "OBSERVED",
            "UNKNOWN"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "origin": {
          "default": "DECLARED",
          "enum": [
            "LEGACY",
            "DECLARED",
            "CONFIGURATION"
          ],
          "title": "Origin",
          "type": "string"
        },
        "protocol": {
          "default": "UNKNOWN",
          "enum": [
            "https",
            "http",
            "tcp",
            "udp",
            "postgresql",
            "mysql",
            "redis",
            "rediss",
            "mongodb",
            "mongodb+srv",
            "s3",
            "UNKNOWN"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "purpose": {
          "default": "UNKNOWN",
          "enum": [
            "REQUEST",
            "DATA",
            "EVENT",
            "TELEMETRY",
            "BUILD",
            "CONFIG_REFERENCE",
            "SECURITY_RULE",
            "IAM_PERMISSION",
            "UNKNOWN"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Target",
          "type": "string"
        },
        "tls": {
          "default": "UNKNOWN",
          "enum": [
            "REQUIRED",
            "DISABLED",
            "UNKNOWN"
          ],
          "title": "Tls",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "Connection",
      "type": "object"
    },
    "DeclaredBinding": {
      "additionalProperties": false,
      "properties": {
        "execution": {
          "default": "unknown",
          "enum": [
            "browser",
            "server",
            "server-proxy",
            "unknown"
          ],
          "title": "Execution",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
          "title": "Name",
          "type": "string"
        },
        "protocol": {
          "default": "unknown",
          "enum": [
            "https",
            "http",
            "postgresql",
            "mysql",
            "redis",
            "rediss",
            "mongodb",
            "mongodb+srv",
            "s3",
            "unknown"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "DeclaredBinding",
      "type": "object"
    },
    "EIPNetworkConfiguration": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "$ref": "#/$defs/Empty"
        },
        "resource_type": {
          "const": "AWS::EC2::EIP",
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "properties"
      ],
      "title": "EIPNetworkConfiguration",
      "type": "object"
    },
    "Egress": {
      "additionalProperties": false,
      "properties": {
        "allow_public_https_egress": {
          "default": false,
          "description": "Required for a 0.0.0.0/0 TCP 443 outbound rule; this does not verify TLS or destination trust.",
          "title": "Explicitly allow public HTTPS egress",
          "type": "boolean"
        },
        "from_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "From port",
          "type": "integer"
        },
        "group_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::SecurityGroup",
          "title": "Security group",
          "type": "string"
        },
        "peer": {
          "maxLength": 64,
          "minLength": 1,
          "reference_by": {
            "field": "peer_kind",
            "types": {
              "SECURITY_GROUP": "AWS::EC2::SecurityGroup"
            }
          },
          "title": "Peer resource or IPv4 CIDR",
          "type": "string"
        },
        "peer_kind": {
          "enum": [
            "SECURITY_GROUP",
            "CIDR"
          ],
          "title": "Peer type",
          "type": "string"
        },
        "protocol": {
          "default": "tcp",
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "to_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "To port",
          "type": "integer"
        }
      },
      "required": [
        "group_node_id",
        "from_port",
        "to_port",
        "peer_kind",
        "peer"
      ],
      "title": "Egress",
      "type": "object"
    },
    "Empty": {
      "additionalProperties": false,
      "properties": {},
      "title": "Empty",
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "version": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "data"
      ],
      "title": "Extension",
      "type": "object"
    },
    "InternetGatewayNetworkConfiguration": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "$ref": "#/$defs/Empty"
        },
        "resource_type": {
          "const": "AWS::EC2::InternetGateway",
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "properties"
      ],
      "title": "InternetGatewayNetworkConfiguration",
      "type": "object"
    },
    "JsonValue": {},
    "LogConfiguration": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "$ref": "#/$defs/LogProperties"
        },
        "resource_type": {
          "const": "AWS::Logs::LogGroup",
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "properties"
      ],
      "title": "LogConfiguration",
      "type": "object"
    },
    "LogProperties": {
      "additionalProperties": false,
      "properties": {
        "retention_days": {
          "default": 30,
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90,
            120,
            150,
            180,
            365,
            400,
            545,
            731,
            1096,
            1827,
            2192,
            2557,
            2922,
            3288,
            3653
          ],
          "title": "Retention in days",
          "type": "integer"
        }
      },
      "title": "LogProperties",
      "type": "object"
    },
    "NatGateway": {
      "additionalProperties": false,
      "properties": {
        "allocation_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::EIP",
          "title": "Dedicated Elastic IP",
          "type": "string"
        },
        "subnet_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::Subnet",
          "title": "Public subnet",
          "type": "string"
        }
      },
      "required": [
        "subnet_node_id",
        "allocation_node_id"
      ],
      "title": "NatGateway",
      "type": "object"
    },
    "NatGatewayNetworkConfiguration": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "$ref": "#/$defs/NatGateway"
        },
        "resource_type": {
          "const": "AWS::EC2::NatGateway",
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "properties"
      ],
      "title": "NatGatewayNetworkConfiguration",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "x": {
          "maximum": 6000,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 6000,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "anyOf": [
            {
              "enum": [
                "SINGLE_AZ",
                "MULTI_AZ",
                "MULTI_REGION"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability"
        },
        "concurrent_users": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concurrent Users"
        },
        "peak_requests_per_minute": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Requests Per Minute"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}(?:-[a-z]+)+-\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "requests_per_second_per_replica": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "gt": 0,
              "le": 1000000
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requests Per Second Per Replica"
        },
        "secondary_region": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}(?:-[a-z]+)+-\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary Region"
        },
        "sizing_workload_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sizing Workload Id"
        },
        "workload_policies": {
          "items": {
            "$ref": "#/$defs/WorkloadPolicy"
          },
          "maxItems": 80,
          "title": "Workload Policies",
          "type": "array"
        }
      },
      "title": "Requirements",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceCapabilities"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_type": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Type"
        },
        "compiler_logical_id": {
          "pattern": "^Lc[a-f0-9]{40}$",
          "title": "Compiler Logical Id",
          "type": "string"
        },
        "configuration": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "AWS::EC2::EIP": "#/$defs/EIPNetworkConfiguration",
                  "AWS::EC2::InternetGateway": "#/$defs/InternetGatewayNetworkConfiguration",
                  "AWS::EC2::NatGateway": "#/$defs/NatGatewayNetworkConfiguration",
                  "AWS::EC2::Route": "#/$defs/RouteNetworkConfiguration",
                  "AWS::EC2::RouteTable": "#/$defs/RouteTableNetworkConfiguration",
                  "AWS::EC2::SecurityGroup": "#/$defs/SecurityGroupNetworkConfiguration",
                  "AWS::EC2::SecurityGroupEgress": "#/$defs/SecurityGroupEgressNetworkConfiguration",
                  "AWS::EC2::SecurityGroupIngress": "#/$defs/SecurityGroupIngressNetworkConfiguration",
                  "AWS::EC2::Subnet": "#/$defs/SubnetConfiguration",
                  "AWS::EC2::SubnetRouteTableAssociation": "#/$defs/SubnetRouteTableAssociationNetworkConfiguration",
                  "AWS::EC2::VPC": "#/$defs/VpcConfiguration",
                  "AWS::EC2::VPCEndpoint": "#/$defs/VPCEndpointNetworkConfiguration",
                  "AWS::EC2::VPCGatewayAttachment": "#/$defs/VPCGatewayAttachmentNetworkConfiguration",
                  "AWS::Logs::LogGroup": "#/$defs/LogConfiguration",
                  "AWS::S3::Bucket": "#/$defs/BucketConfiguration"
                },
                "propertyName": "resource_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/VpcConfiguration"
                },
                {
                  "$ref": "#/$defs/SubnetConfiguration"
                },
                {
                  "$ref": "#/$defs/BucketConfiguration"
                },
                {
                  "$ref": "#/$defs/LogConfiguration"
                },
                {
                  "$ref": "#/$defs/RouteTableNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/SubnetRouteTableAssociationNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/InternetGatewayNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/VPCGatewayAttachmentNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/RouteNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/EIPNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/NatGatewayNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/SecurityGroupNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/SecurityGroupIngressNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/SecurityGroupEgressNetworkConfiguration"
                },
                {
                  "$ref": "#/$defs/VPCEndpointNetworkConfiguration"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration"
        },
        "configuration_schema_version": {
          "const": 1,
          "default": 1,
          "title": "Configuration Schema Version",
          "type": "integer"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "layer": {
          "enum": [
            "EDGE",
            "APPLICATION",
            "DATA",
            "SUPPORT"
          ],
          "title": "Layer",
          "type": "string"
        },
        "legacy_service": {
          "maxLength": 100,
          "title": "Legacy Service",
          "type": "string"
        },
        "ownership": {
          "default": "PLANNED",
          "enum": [
            "PLANNED",
            "DISCOVERED_UNMANAGED",
            "IMPORT_PENDING",
            "STACK_MANAGED"
          ],
          "title": "Ownership",
          "type": "string"
        },
        "ownership_evidence_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Evidence Ref"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "id",
        "label",
        "legacy_service",
        "layer",
        "compiler_logical_id"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceCapabilities": {
      "additionalProperties": false,
      "properties": {
        "cloudformation_export": {
          "default": false,
          "title": "Cloudformation Export",
          "type": "boolean"
        },
        "configuration": {
          "default": false,
          "title": "Configuration",
          "type": "boolean"
        },
        "drawable": {
          "const": true,
          "default": true,
          "title": "Drawable",
          "type": "boolean"
        },
        "drift_management": {
          "const": false,
          "default": false,
          "title": "Drift Management",
          "type": "boolean"
        },
        "verified_deployment": {
          "const": false,
          "default": false,
          "title": "Verified Deployment",
          "type": "boolean"
        }
      },
      "title": "ResourceCapabilities",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "destination_cidr": {
          "default": "0.0.0.0/0",
          "maxLength": 18,
          "title": "Destination IPv4 CIDR",
          "type": "string"
        },
        "route_table_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_type": "AWS::EC2::RouteTable",
          "title": "Route table",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "INTERNET_GATEWAY",
            "NAT_GATEWAY"
          ],
          "title": "Route target",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "reference_by": {
            "field": "target_kind",
            "types": {
              "INTERNET_GATEWAY": "AWS::EC2::InternetGateway",
              "NAT_GATEWAY": "AWS::EC2::NatGateway"
            }
          },
          "title": "Target resource",
          "type": "string"
        }
      },
      "required": [
        "route_table_node_id",
        "target_kind",
        "target_node_id"
      ],
      "title": "Route",
      "type": "object"
    },
    "RouteNetworkConfiguration": {
      "additionalProperties": false,
      "properties": {
        "properties": {
